{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "brand": {
      "$type": "color",
      "primary": { "$value": { "colorSpace": "srgb", "components": [0.043137, 0.239216, 0.568627], "hex": "#0B3D91" } },
      "action": { "$value": { "colorSpace": "srgb", "components": [0.090196, 0.427451, 0.898039], "hex": "#176DE5" } },
      "accent": { "$value": { "colorSpace": "srgb", "components": [1, 0.478431, 0], "hex": "#FF7A00" } },
      "accentWarm": { "$value": { "colorSpace": "srgb", "components": [1, 0.580392, 0.247059], "hex": "#FF943F" } }
    },
    "surface": {
      "$type": "color",
      "canvas": { "$value": { "colorSpace": "srgb", "components": [0.960784, 0.980392, 1], "hex": "#F5FAFF" } },
      "base": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
      "raised": { "$value": { "colorSpace": "srgb", "components": [0.968627, 0.984314, 1], "hex": "#F7FBFF" } },
      "soft": { "$value": { "colorSpace": "srgb", "components": [0.917647, 0.960784, 1], "hex": "#EAF5FF" } }
    },
    "content": {
      "$type": "color",
      "text": { "$value": { "colorSpace": "srgb", "components": [0.066667, 0.196078, 0.372549], "hex": "#11325F" } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.396078, 0.490196, 0.6], "hex": "#657D99" } },
      "onStrong": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } }
    },
    "border": {
      "$type": "color",
      "default": { "$value": { "colorSpace": "srgb", "components": [0.858824, 0.909804, 0.956863], "hex": "#DBE8F4" } },
      "strong": { "$value": { "colorSpace": "srgb", "components": [0.780392, 0.862745, 0.92549], "hex": "#C7DCEC" } }
    },
    "state": {
      "$type": "color",
      "success": { "$value": { "colorSpace": "srgb", "components": [0.086275, 0.521569, 0.356863], "hex": "#16855B" } },
      "warning": { "$value": { "colorSpace": "srgb", "components": [0.662745, 0.411765, 0.05098], "hex": "#A9690D" } },
      "danger": { "$value": { "colorSpace": "srgb", "components": [0.768627, 0.239216, 0.239216], "hex": "#C43D3D" } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "7": { "$value": { "value": 32, "unit": "px" } },
    "8": { "$value": { "value": 40, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 12, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 22, "unit": "px" } },
    "xl": { "$value": { "value": 28, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$value": { "value": 44, "unit": "px" } },
    "contentWide": { "$value": { "value": 1240, "unit": "px" } },
    "minViewport": { "$value": { "value": 320, "unit": "px" } }
  },
  "typography": {
    "fontSize": {
      "$type": "dimension",
      "label": { "$value": { "value": 11, "unit": "px" } },
      "bodySm": { "$value": { "value": 12, "unit": "px" } },
      "bodyMd": { "$value": { "value": 14, "unit": "px" } },
      "titleMd": { "$value": { "value": 22, "unit": "px" } },
      "titleLg": { "$value": { "value": 34, "unit": "px" } },
      "display": { "$value": { "value": 48, "unit": "px" } }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 140, "unit": "ms" } },
      "standard": { "$value": { "value": 220, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.8, 0.2, 1] }
    }
  },
  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "{size.touchTarget}" },
      "radius": { "$type": "dimension", "$value": "{radius.sm}" },
      "primaryBackground": { "$type": "color", "$value": "{color.brand.action}" },
      "accentBackground": { "$type": "color", "$value": "{color.brand.accent}" },
      "strongText": { "$type": "color", "$value": "{color.content.onStrong}" }
    },
    "input": {
      "minHeight": { "$type": "dimension", "$value": "{size.touchTarget}" },
      "radius": { "$type": "dimension", "$value": "{radius.md}" },
      "background": { "$type": "color", "$value": "{color.surface.base}" },
      "text": { "$type": "color", "$value": "{color.content.text}" }
    },
    "card": {
      "radius": { "$type": "dimension", "$value": "{radius.lg}" },
      "background": { "$type": "color", "$value": "{color.surface.base}" },
      "border": { "$type": "color", "$value": "{color.border.default}" }
    }
  }
}
