  "rules": {
    "productionRebuildForbidden": true,
    "exactArtifactVerificationRequired": true,
    "rollbackArtifactRequired": true,
    "ownerReadableReleaseDetailsRequired": true,
    "releaseTrackIdentityRequired": true
  }
