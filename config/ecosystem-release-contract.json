    "product",
    "version",
    "sourceSha",
    "artifactSha256",
    "schemaVersion",
    "builtAt"
  ],
  "requiredReleaseSafety": [
    "qaStatus",
    "backupRequired",
    "rollbackReady",
    "compatibility"
  ],
  "sourceShaPattern": "^[0-9a-f]{40}$",
  "artifactSha256Pattern": "^[0-9a-f]{64}$",
  "releaseTracks": {
