      "name": "VPS Platform",
      "kind": "PLATFORM",
      "repository": "awh",
      "productionRef": "refs/heads/platform/production",
      "independentVersion": true,
      "independentHistory": true,
      "independentRollback": true,
      "ownerApprovalRequired": true
    },
    "awh": {
      "name": "AWH",
      "kind": "CORE",
      "repository": "awh",
      "productionRef": "refs/heads/production",
      "independentVersion": true,
      "independentHistory": true,
      "independentRollback": true,
      "ownerApprovalRequired": true
    },
    "awh-agent": {
      "name": "AWH Agent",
      "kind": "AGENT",
      "repository": "awh-local-agent",
      "productionRef": "refs/heads/main",
      "independentVersion": true,
      "independentHistory": true,
      "independentRollback": true,
      "ownerApprovalRequired": true
    }
  },
  "products": {
    "awh": {"project": "Art’s Workspace Hub", "kind": "CORE"},
    "bay-excuse-x": {"project": "BAY EXCUSE X", "kind": "SYSTEM"},
    "bay-hub": {"project": "BAY Hub", "kind": "HUB"},
    "bay-learnlab": {"project": "BAY LearnLab", "kind": "PRODUCT"},
    "bay-assessment": {"project": "BAY Assessment", "kind": "PRODUCT"},
    "school-website": {"project": "เว็บไซต์โรงเรียน", "kind": "HOSTING"},
    "bay-computer-lab": {"project": "BAY Computer Lab", "kind": "SYSTEM"}
