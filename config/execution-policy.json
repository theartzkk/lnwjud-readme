{
  "schemaVersion": 2,
  "mode": "CONTEXT_ONLY",
  "prescriptivePolicy": false,
  "runtimeDefaults": {
    "deviceLeaseMinutes": 45,
    "historyRetentionDays": 30,
    "maxHistoryFiles": 500
  },
  "integrity": {
    "singleWriterPerMutationScope": true,
    "readOnlyConcurrencyAllowed": true,
    "mutationAuthority": "control_execution_envelopes",
    "secondWriterBehavior": "WAIT_OR_JOIN",
    "globalMutationResources": [
      "CANONICAL:DEPLOY:VPS_PLATFORM"
    ],
    "sameProjectInterlocks": [
      "CANONICAL:SOURCE<->CANONICAL:DEPLOY:*",
      "RESOURCE:RELEASE_STAGE<->CANONICAL:DEPLOY:*"
    ],
    "localMissionAuthorityClass": "DEVICE_TRANSPORT_LEASE",
    "parallelLockAuthorityAllowed": false,
    "releaseTrackAuthority": "HubUpdateTargetRegistry::releaseTracks",
    "writerIdentity": "EXECUTION_ID+MUTATION_RESOURCE",
    "projectScopedMutationIsolation": true,
    "crossProjectMutationDefault": "DENY",
    "crossProjectReadOnlyAllowed": true,
    "sourcePromotionRequiresTargetProjectMission": true,
    "projectScopeAuthority": "PROJECT_REGISTRY+MISSION_EXECUTION_PROJECT",
    "completionAuthority": "HubCompletionAuthorityService",
    "completionNotificationRequiresVerifiedTerminal": true,
    "resumeAuthority": "EXECUTION_CHECKPOINT+HEARTBEAT",
    "terminalStateEvidence": "TASK+EXECUTION+ENVELOPE+APPROVAL+CONTINUATION",
    "hostGlobalTrack": "vps-platform"
  },
  "qa": {
    "riskBudget": {
      "LOW": "FAST",
      "MEDIUM": "STANDARD",
      "HIGH": "DEEP",
      "CRITICAL": "DEEP"
    },
    "scriptByBudget": {
      "FAST": "qa:fast",
      "STANDARD": "qa:fast",
      "DEEP": "qa:local"
    },
    "fullSuiteOnlyAtReleaseOrExplicitDeep": true,
    "singleFlight": {
      "enabled": true,
      "scope": "PROJECT",
      "serializeDeepTests": true,
      "reuseExactShaResult": true,
      "staleMinutes": 30,
      "waitMinutes": 20
    }
  },
  "privilegeRouting": {
    "preflightRequired": true,
    "defaultPrivilegedLane": "TYPED_OPERATOR",
    "privilegedMutationLanes": [
      "TYPED_OPERATOR",
      "OWNER_RELAY"
    ],
    "restrictedSessionIdentities": [
      "awh-remote"
    ],
    "noNewPrivilegesFailFast": true,
    "directSudoFromRestrictedSessionAllowed": false,
    "userConsoleFallbackAllowed": false,
    "ownerRelayRequiresExplicitApproval": true
  },
  "diagnosticAuthority": {
    "sandboxedConnectorFilesystemViewIsHostAuthority": false,
    "hostFilesystemIncidentRequiresAuthorityCrossCheck": true,
    "authoritativeHostSignals": [
      "TYPED_AWH_OPERATOR",
      "AWH_STORAGE_GUARD",
      "BLOCK_DEVICE_STATE",
      "EFFECTIVE_HOST_SERVICE_NAMESPACE"
    ],
    "destructiveHostRepairFromConnectorOnlyEvidenceAllowed": false,
    "classifyConnectorOnlyFilesystemObservationAs": "SANDBOX_VIEW"
  },
  "toolchainRouting": {
    "preserveVerifiedRuntimeAcrossPrivilegeBoundary": true,
    "releaseNodeMajorMin": 22,
    "releaseNodeCandidates": [
      "/opt/awh-toolchain/node/bin/node",
      "/opt/awh-toolchain/node-v*-linux-x64/bin/node",
      "/opt/awh-tools/remote-desktop/node-v*-linux-x64/bin/node",
      "/usr/local/bin/node",
      "/usr/bin/node"
    ],
    "dependencyHydration": {
      "requiredBeforeDeepQa": true,
      "strategy": "NPM_CI_PREFER_OFFLINE",
      "lockfileExact": true
    }
  },
  "blockerHandling": {
    "mode": "OWNER_ASSIST_FAST_LANE",
    "maxSameFailureRetries": 2,
    "silentWaitAllowed": false,
    "surfaceOwnerAssistWhenFaster": true,
    "permanentFixRequiredForRecurringBlocker": true,
    "closureEvidence": [
      "rootCause",
      "prevention",
      "regression",
      "recovery",
      "observability"
    ],
    "requiredOwnerAssistFields": [
      "blocker",
      "fastestOwnerAction",
      "estimatedOwnerTime",
      "resumeAction"
    ]
  },
  "workspaceRouting": {
    "durableCandidateRoot": "/var/lib/awh-remote/worktrees",
    "ephemeralRoot": "/tmp",
    "unpromotedCandidateInEphemeralRootAllowed": false,
    "ephemeralWorkMustBeReproducible": true
  },
  "storageSafety": {
    "targetFreeBytes": 6442450944,
    "warningFreeBytes": 6442450944,
    "blockFreeBytes": 3221225472,
    "criticalFreeBytes": 1610612736,
    "tempPressureBytes": 2147483648,
    "selfHealBeforeBlock": true,
    "projectAwareJanitor": true,
    "janitorFailClosedWhenAuthorityUnknown": true,
    "pressureKeepNewestPerRepo": 2,
    "pressureMinAgeMinutes": 60
  }
}
