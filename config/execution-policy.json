{
  "schemaVersion": 1,
  "remoteMission": {
    "targetMinutes": 30,
    "allowLonger": true,
    "quotaIsTelemetryOnly": true,
    "resumeFirst": true,
    "progressHeartbeatMinutes": {
      "min": 3,
      "max": 5
    },
    "processPollSeconds": {
      "min": 120,
      "max": 300
    },
    "deviceLeaseMinutes": 45,
    "finishEarlyOnlyFor": [
      "COMPLETE",
      "HARD_BLOCKER",
      "OWNER_APPROVAL_REQUIRED",
      "PLATFORM_INTERRUPTION"
    ],
    "historyRetentionDays": 30,
    "maxHistoryFiles": 500,
    "subprocessCompletionEndsMission": false,
    "heartbeatRequiresProofOfWork": true,
    "finalWhileActiveMission": "FORBIDDEN_UNLESS_COMPLETE_BLOCKED_APPROVAL_OR_PLATFORM_INTERRUPTION",
    "autoChainSafeNextStep": true,
    "durableProcessThresholdSeconds": 120,
    "heartbeatDetailLevel": "DETAILED",
    "heartbeatMustContinueAfterSend": true,
    "heartbeatProgressMode": "STAGE_BASED_NO_FALSE_PERCENT",
    "heartbeatProofMaxAgeSeconds": 300,
    "heartbeatRequiredFields": [
      "elapsed",
      "doneSinceLast",
      "currentOperation",
      "stage",
      "proofOfWork",
      "activePidOrApp",
      "lastSaveOrArtifact",
      "nextSteps",
      "blocker"
    ]
  },
  "gateTiers": {
    "G0": {
      "name": "OBSERVE",
      "ownerApproval": false
    },
    "G1": {
      "name": "REVERSIBLE_WORK",
      "ownerApproval": false
    },
    "G2": {
      "name": "REVERSIBLE_PRODUCTION",
      "ownerApproval": "ONE_EXACT_REVISION_SCOPE"
    },
    "G3": {
      "name": "IRREVERSIBLE_OR_TRUST_BOUNDARY",
      "ownerApproval": "ACTION_SPECIFIC"
    }
  },
  "sourceAuthority": {
    "codeOperational": "VPS_GIT_MAIN",
    "vaultForCode": "SNAPSHOT_EVIDENCE_RECOVERY",
    "nonGitCanonical": "AWH_VAULT_OR_PROJECT_SOURCES",
    "personalEndpointTransitForbidden": true
  },
  "qa": {
    "riskBudget": {
      "LOW": "FAST",
      "MEDIUM": "STANDARD",
      "HIGH": "DEEP",
      "CRITICAL": "DEEP"
    },
    "scriptByBudget": {
      "FAST": "qa:fast",
      "STANDARD": "qa:fast",
      "DEEP": "qa:local"
    },
    "fullSuiteOnlyAtReleaseOrExplicitDeep": true
  }
}
