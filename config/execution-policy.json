{
  "schemaVersion": 2,
  "mode": "CONTEXT_ONLY",
  "prescriptivePolicy": false,
  "runtimeDefaults": {
    "deviceLeaseMinutes": 45,
    "historyRetentionDays": 30,
    "maxHistoryFiles": 500
  },
  "integrity": {
    "singleWriterPerMutationScope": true,
    "readOnlyConcurrencyAllowed": true
  },
  "qa": {
    "riskBudget": {
      "LOW": "FAST",
      "MEDIUM": "STANDARD",
      "HIGH": "DEEP",
      "CRITICAL": "DEEP"
    },
    "scriptByBudget": {
      "FAST": "qa:fast",
      "STANDARD": "qa:fast",
      "DEEP": "qa:local"
    },
    "fullSuiteOnlyAtReleaseOrExplicitDeep": true,
    "singleFlight": {
      "enabled": true,
      "scope": "PROJECT",
      "serializeDeepTests": true,
      "reuseExactShaResult": true,
      "staleMinutes": 30,
      "waitMinutes": 20
    }
  }
}
