{
  "schemaVersion": 1,
  "authority": "AWH_REPOSITORY_GOVERNANCE",
  "canonicalSourceBranch": "main",
  "rules": {
    "requiredAgentEntrypoint": "AGENTS.md",
    "liveEvidenceOnlyForMutableFacts": true,
    "typedSourcePromotionOnly": true,
    "resourceScopedMutationOwnership": true,
    "mutationDecisionAuthority": "AWH_EXECUTION_GATE",
    "blockingDecision": "WAIT_CONFLICT",
    "nonBlockingDecisions": [
      "CONTINUE",
      "CONTINUE_OR_JOIN"
    ],
    "projectMissionIsCoordinationOnly": true,
    "projectScopedMutationIsolation": true,
    "crossProjectMutationDefault": "DENY",
    "crossProjectReadOnlyAllowed": true,
    "sourcePromotionRequiresTargetProjectMission": true,
    "verifiedCompletionAuthority": "HubCompletionAuthorityService",
    "completionNotificationRequiresVerifiedTerminal": true,
    "heartbeatResumeCursorRequired": true,
    "terminalStateEvidence": "TASK+EXECUTION+ENVELOPE+APPROVAL+CONTINUATION",
    "aggregateActiveCountsAreNotBlockingAuthority": true,
    "releaseTrackScopedDeployOwnership": true,
    "hostGlobalReleaseTrack": "vps-platform",
    "forbidParallelAuthorityFiles": true,
    "forbiddenAuthorityBasenames": [
      "RULES.md",
      "CLAUDE.md",
      "CODEX.md",
      "GEMINI.md",
      "CONSTITUTION.md",
      "INSTRUCTIONS.md"
    ],
    "historicalRoot": "history/",
    "contextFilesMustDeclareRole": true,
    "projectManifestPath": ".awh/project.json",
    "mutableFactPatterns": [
      "\\b[0-9a-f]{40}\\b",
      "\\b(?:schema|user_version)\\s*(?:=|version)?\\s*\\d+\\b",
      "\\bProduction\\s+(?:is|=|at|stays|remains)\\b"
    ]
  },
  "repositories": {
    "awh": {
      "project": "Art’s Workspace Hub",
      "projectId": "113b45c0-23e1-408d-ae0f-ac5eca7f6900",
      "directory": "awh.git",
      "canonicalBranch": "main",
      "defaultHead": "production",
      "requireProjectManifest": true,
      "contextFiles": {
        "ARCHITECTURE.md": "CONTEXT_ONLY_ARCHITECTURE",
        "PROJECT.md": "CONTEXT_ONLY_PROJECT",
        "CURRENT_STATE.md": "CONTEXT_ONLY_STATE_INDEX",
        "HANDOFF.md": "CONTEXT_ONLY_HANDOFF_INDEX",
        "TASKS.md": "CONTEXT_ONLY_TASK_INDEX",
        "DECISIONS.md": "HISTORICAL_DECISION_INDEX",
        "KRUART_ECOSYSTEM_MASTER_CONTROL.md": "HISTORICAL_POINTER"
      }
    },
    "awh-local-agent": {
      "project": null,
      "projectId": null,
