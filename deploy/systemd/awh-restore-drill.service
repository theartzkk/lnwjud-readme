[Unit]
Description=AWH weekly verified restore drill
After=awh-backup.service local-fs.target

[Service]
Type=oneshot
ExecStart=/opt/awh-hub/control-plane-current/deploy/awh-storage/awh-restore-drill
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/awh-hub /var/backups/awh-hub
ReadWritePaths=/var/tmp /var/lib/awh-hub
