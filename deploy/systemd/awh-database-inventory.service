[Unit]
Description=AWH sanitized database fleet inventory
After=mariadb.service local-fs.target
ConditionPathExists=/var/lib/awh-hub/awh.sqlite

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/awh-database-inventory.py
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/awh-hub
LockPersonality=true
RestrictRealtime=true
