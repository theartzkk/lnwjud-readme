[Unit]
Description=AWH VPS storage guard
After=local-fs.target systemd-journald.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/awh-storage-guard
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/awh-hub /tmp /var/cache/apt /var/log/journal /run/log/journal
