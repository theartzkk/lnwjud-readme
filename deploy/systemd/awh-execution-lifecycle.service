[Unit]
Description=AWH execution lifecycle reconciler
After=local-fs.target
[Service]
Type=oneshot
User=awh-hub
Group=awh-hub
Environment=AWH_HUB_DB_PATH=/var/lib/awh-hub/awh.sqlite
ExecStart=/usr/bin/php /opt/awh-hub/control-plane-current/hub/bin/reconcile-execution-lifecycle.php
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/awh-hub
