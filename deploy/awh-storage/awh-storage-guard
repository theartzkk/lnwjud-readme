#!/usr/bin/env bash
set -euo pipefail
STATE_DIR=/var/lib/awh-hub
STATE_FILE="$STATE_DIR/storage-guard.state"
JSON_FILE="$STATE_DIR/storage-guard.json"
EVENT_FILE="$STATE_DIR/storage-guard-events.log"
INVENTORY_FILE="$STATE_DIR/storage-inventory.json"
INVENTORY_TOOL=/opt/awh-hub/control-plane-current/deploy/awh-storage/awh-storage-inventory.py
WARN=75
BLOCK=90
CRIT=95
RECOVER=72
TARGET_FREE=17179869184
WARN_FREE=17179869184
BLOCK_FREE=3221225472
CRIT_FREE=1610612736

mkdir -p "$STATE_DIR"
if [[ -x "$INVENTORY_TOOL" || -f "$INVENTORY_TOOL" ]]; then
  /usr/bin/python3 "$INVENTORY_TOOL" --output "$INVENTORY_FILE" --max-age-seconds 3600 >/dev/null 2>&1 || logger -t awh-storage-guard "storage_inventory_failed"
fi
used=$(df -P / | awk 'NR==2{gsub(/%/,"",$5);print $5}')
avail=$(df -B1 --output=avail / | tail -1 | tr -d ' ')
total=$(df -B1 --output=size / | tail -1 | tr -d ' ')
now=$(date --iso-8601=seconds)
prev=$(cat "$STATE_FILE" 2>/dev/null || echo UNKNOWN)

if (( used >= CRIT || avail < CRIT_FREE )); then
  state=CRITICAL
elif (( used >= WARN || avail < WARN_FREE )); then
  state=WARNING
elif [[ "$prev" == "WARNING" || "$prev" == "CRITICAL" ]] && (( used > RECOVER || avail < WARN_FREE )); then
  state="$prev"
else
  state=NORMAL
fi

# Bounded low-risk self-healing. Never touches backups/releases/databases/artifacts.
if [[ "$state" == "WARNING" || "$state" == "CRITICAL" ]]; then
  AWH_STORAGE_PRESSURE=1 AWH_TMP_TARGET_FREE_BYTES="$TARGET_FREE" AWH_TMP_KEEP_NEWEST_PER_REPO=1 AWH_DURABLE_KEEP_NEWEST_PER_REPO=1 AWH_DURABLE_PRESSURE_MAX_DELETE_PER_RUN=64 AWH_AGENT_PUBLISH_CLEANUP_AUTHORITY=STORAGE_GUARD_PRESSURE_V1 AWH_AGENT_PUBLISH_MAX_DELETE_PER_RUN=1 /opt/awh-hub/control-plane-current/deploy/awh-storage/awh-temp-cleanup >/dev/null 2>&1 || true
fi
if (( used >= BLOCK || avail < BLOCK_FREE )); then
  journalctl --vacuum-size=300M >/dev/null 2>&1 || true
  apt-get clean >/dev/null 2>&1 || true
fi

used=$(df -P / | awk 'NR==2{gsub(/%/,"",$5);print $5}')
avail=$(df -B1 --output=avail / | tail -1 | tr -d ' ')
release_blocked=false
if (( used >= BLOCK || avail < BLOCK_FREE )); then release_blocked=true; fi
if (( used >= CRIT || avail < CRIT_FREE )); then
  state=CRITICAL
elif (( used >= WARN || avail < WARN_FREE )); then
  state=WARNING
elif (( used <= RECOVER && avail >= WARN_FREE )); then
  state=NORMAL
fi

printf '%s\n' "$state" > "$STATE_FILE"
tmp="${JSON_FILE}.tmp"
printf '{"schemaVersion":1,"checkedAt":"%s","state":"%s","usedPercent":%d,"freeBytes":%s,"totalBytes":%s,"warningPercent":%d,"blockPercent":%d,"criticalPercent":%d,"recoveryPercent":%d,"targetFreeBytes":%s,"warningFreeBytes":%s,"blockFreeBytes":%s,"criticalFreeBytes":%s,"releaseBlocked":%s}\n' "$now" "$state" "$used" "$avail" "$total" "$WARN" "$BLOCK" "$CRIT" "$RECOVER" "$TARGET_FREE" "$WARN_FREE" "$BLOCK_FREE" "$CRIT_FREE" "$release_blocked" > "$tmp"
chmod 0640 "$tmp"
chown root:awh-hub "$tmp" 2>/dev/null || true
mv -f "$tmp" "$JSON_FILE"

if [[ "$state" != "$prev" ]]; then
  msg="state=$state previous=$prev used_percent=$used free_bytes=$avail"
  logger -t awh-storage-guard "$msg"
  printf '%s %s\n' "$now" "$msg" >> "$EVENT_FILE"
  tail -n 100 "$EVENT_FILE" > "${EVENT_FILE}.tmp" && mv -f "${EVENT_FILE}.tmp" "$EVENT_FILE"
  chmod 0640 "$EVENT_FILE"
  chown root:awh-hub "$EVENT_FILE" 2>/dev/null || true
fi
