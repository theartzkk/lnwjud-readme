#!/usr/bin/env bash
set -euo pipefail
CANONICAL_AWH_GIT=${AWH_CANONICAL_AWH_GIT:-/srv/awh-git/awh.git}
CANONICAL_BAY_GIT=${AWH_CANONICAL_BAY_GIT:-/srv/awh-git/bay-excuse-x.git}
CANONICAL_ROOT=${AWH_CANONICAL_ROOT:-/srv/awh-git}
REMOTE_ELECTRON_CACHE=${AWH_REMOTE_ELECTRON_CACHE:-/var/lib/awh-remote/.cache/electron}
REMOTE_NPM_CACHE=${AWH_REMOTE_NPM_CACHE:-/var/lib/awh-remote/.npm/_cacache}
CORE_NPM_CACHE=${AWH_CORE_NPM_CACHE:-/var/lib/awh-hub/npm-cache}
CORE_NPM_CACHE_MAX_BYTES=${AWH_CORE_NPM_CACHE_MAX_BYTES:-2147483648}
REMOTE_UV_CACHE=${AWH_REMOTE_UV_CACHE:-/var/lib/awh-remote/.cache/uv}
HUB_DB=${AWH_HUB_DB_PATH:-/var/lib/awh-hub/awh.sqlite}
TEMP_ROOT=${AWH_TEMP_ROOT:-/tmp}
REMOTE_TEMP_ROOT=${AWH_REMOTE_TEMP_ROOT:-/var/lib/awh-remote/tmp}
OPERATOR_STAGE_ROOT=${AWH_OPERATOR_STAGE_ROOT:-/var/lib/awh-remote/operator-staging}
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
WORKSPACE_JANITOR=${AWH_TEMP_WORKSPACE_JANITOR:-$SCRIPT_DIR/awh-temp-workspace-janitor.py}
DIR_MAX_AGE_MINUTES=${AWH_TEMP_DIR_MAX_AGE_MINUTES:-720}
REMOTE_PRIVATE_MAX_AGE_MINUTES=${AWH_REMOTE_PRIVATE_MAX_AGE_MINUTES:-180}
REMOTE_TRANSIENT_MAX_AGE_MINUTES=${AWH_REMOTE_TRANSIENT_MAX_AGE_MINUTES:-720}
OPERATOR_STAGE_MAX_AGE_MINUTES=${AWH_OPERATOR_STAGE_MAX_AGE_MINUTES:-1440}
DEPENDENCY_MAX_AGE_MINUTES=${AWH_DEPENDENCY_MAX_AGE_MINUTES:-720}
VAULT_EXPORT_MAX_AGE_MINUTES=${AWH_VAULT_EXPORT_MAX_AGE_MINUTES:-360}
if [[ "${AWH_STORAGE_PRESSURE:-0}" == 1 ]]; then
  DIR_MAX_AGE_MINUTES=${AWH_PRESSURE_DIR_MAX_AGE_MINUTES:-60}
  REMOTE_PRIVATE_MAX_AGE_MINUTES=${AWH_PRESSURE_REMOTE_PRIVATE_MAX_AGE_MINUTES:-60}
  REMOTE_TRANSIENT_MAX_AGE_MINUTES=${AWH_PRESSURE_REMOTE_TRANSIENT_MAX_AGE_MINUTES:-60}
  OPERATOR_STAGE_MAX_AGE_MINUTES=${AWH_PRESSURE_OPERATOR_STAGE_MAX_AGE_MINUTES:-60}
  DEPENDENCY_MAX_AGE_MINUTES=${AWH_PRESSURE_DEPENDENCY_MAX_AGE_MINUTES:-60}
fi
count=0
dir_count=0
remote_dir_count=0
operator_dir_count=0
remote_transient_dir_count=0
bytes=0

purge_old_files() {
  local root=$1
  [[ -d "$root" ]] || return 0
  while IFS= read -r -d '' f; do
    if command -v lsof >/dev/null 2>&1 && lsof "$f" >/dev/null 2>&1; then
      continue
    fi
    local size
    size=$(stat -c %s "$f" 2>/dev/null || echo 0)
    rm -f -- "$f"
    count=$((count+1))
    bytes=$((bytes+size))
  done < <(find "$root" -xdev -maxdepth 1 -type f \( -name 'awh-*' -o -name 'actions-runner-*.tar.gz' \) -mtime +7 -print0)
}
purge_old_files "$TEMP_ROOT"
purge_old_files "$REMOTE_TEMP_ROOT"

git_workspace() {
  local path=$1
  shift
  git -c "safe.directory=$path" -C "$path" "$@"
}

path_in_use() {
  local path=$1 target cwd
  if command -v lsof >/dev/null 2>&1 && lsof +D "$path" >/dev/null 2>&1; then
    return 0
  fi
  target=$(realpath -m -- "$path" 2>/dev/null || printf '%s' "$path")
  for cwd in /proc/[0-9]*/cwd; do
    [[ -e "$cwd" ]] || continue
    current=$(readlink "$cwd" 2>/dev/null || true)
    case "$current" in
      "$target"|"$target"/*) return 0 ;;
    esac
  done
  return 1
}

purge_old_vault_exports() {
  [[ -d "$OPERATOR_STAGE_ROOT" ]] || return 0
  while IFS= read -r -d '' f; do
    path_in_use "$f" && continue
    local size
    size=$(stat -c %s "$f" 2>/dev/null || echo 0)
    rm -f -- "$f"
    count=$((count+1))
    bytes=$((bytes+size))
  done < <(find "$OPERATOR_STAGE_ROOT" -xdev -maxdepth 1 -type f -name 'vault-*.zip' -mmin "+${VAULT_EXPORT_MAX_AGE_MINUTES}" -print0)
}

janitor_state=NOT_AVAILABLE
janitor_reclaimed=0
if [[ -f "$WORKSPACE_JANITOR" ]]; then
  janitor_args=(--apply)
  if [[ "${AWH_STORAGE_PRESSURE:-0}" == 1 ]]; then janitor_args+=(--pressure); fi
  set +e
  janitor_json=$(/usr/bin/python3 "$WORKSPACE_JANITOR" "${janitor_args[@]}" 2>&1)
  janitor_rc=$?
  set -e
  if (( janitor_rc == 0 )); then
    janitor_state=OK
    janitor_reclaimed=$(printf '%s' "$janitor_json" | /usr/bin/python3 -c 'import json,sys; print(int(json.load(sys.stdin).get("reclaimedLogicalBytes",0)))' 2>/dev/null || echo 0)
    [[ "$janitor_reclaimed" =~ ^[0-9]+$ ]] || janitor_reclaimed=0
    bytes=$((bytes+janitor_reclaimed))
  else
    janitor_state=FAILED
    logger -t awh-temp-cleanup "workspace_janitor_failed rc=$janitor_rc"
  fi
fi

workspace_cleanup_allowed=false
global_cleanup_allowed=false
active_mutations=unknown
global_active_mutations=unknown
if [[ -r "$HUB_DB" ]] && command -v sqlite3 >/dev/null 2>&1; then
  mutation_sql="e.required_capability<>'operator.project_mission' AND e.state IN ('LEASED','RUNNING') AND (x.execution_id IS NULL OR (x.mutation_scope<>'READ' AND x.state='ACTIVE' AND (x.lease_expires_at IS NULL OR datetime(x.lease_expires_at)>datetime('now'))))"
  if active_mutations=$(sqlite3 -readonly "$HUB_DB" "SELECT count(*) FROM control_task_executions e JOIN projects p ON p.project_id=e.project_id LEFT JOIN control_execution_envelopes x ON x.execution_id=e.execution_id WHERE p.name='Art’s Workspace Hub' AND $mutation_sql;" 2>/dev/null); then
    [[ "$active_mutations" =~ ^[0-9]+$ ]] && (( active_mutations == 0 )) && workspace_cleanup_allowed=true
  fi
  if global_active_mutations=$(sqlite3 -readonly "$HUB_DB" "SELECT count(*) FROM control_task_executions e LEFT JOIN control_execution_envelopes x ON x.execution_id=e.execution_id WHERE $mutation_sql;" 2>/dev/null); then
    [[ "$global_active_mutations" =~ ^[0-9]+$ ]] && (( global_active_mutations == 0 )) && global_cleanup_allowed=true
  fi
fi

purge_remote_transient_dirs() {
  [[ "$global_cleanup_allowed" == true && -d "$REMOTE_TEMP_ROOT" ]] || return 0
  while IFS= read -r -d '' d; do
    local name owner size
    name=$(basename "$d")
    case "$name" in
      art-agent-*|awh-worker-*|awh-remote-connector-*|awh-artifact-hydration-*|awh-domain-adopt-*|awh-hub-test-*) ;;
      *) continue ;;
    esac
    owner=$(stat -c %U "$d" 2>/dev/null || true)
    [[ "$owner" == awh-remote ]] || continue
    path_in_use "$d" && continue
    size=$(du -sb -- "$d" 2>/dev/null | awk '{print $1}' || echo 0)
    find "$d" -xdev -depth -delete 2>/dev/null || true
    if [[ ! -e "$d" ]]; then
      remote_transient_dir_count=$((remote_transient_dir_count+1))
      bytes=$((bytes+size))
    fi
  done < <(find "$REMOTE_TEMP_ROOT" -xdev -maxdepth 1 -mindepth 1 -type d -mmin "+${REMOTE_TRANSIENT_MAX_AGE_MINUTES}" -print0)
}

purge_remote_transient_dirs

reclaim_git_dir() {
  local d=$1 canonical=$2 bucket=$3
  [[ -d "$d/.git" && ! -L "$d/.git" ]] || return 0
  if command -v lsof >/dev/null 2>&1 && lsof +D "$d" >/dev/null 2>&1; then
    return 0
  fi
  local status head size
  status=$(git_workspace "$d" status --porcelain=v1 2>/dev/null || printf '__UNREADABLE__')
  [[ -z "$status" ]] || return 0
  head=$(git_workspace "$d" rev-parse HEAD 2>/dev/null || true)
  [[ "$head" =~ ^[0-9a-f]{40}$ ]] || return 0
  git --git-dir="$canonical" cat-file -e "${head}^{commit}" 2>/dev/null || return 0
  git --git-dir="$canonical" for-each-ref --format='%(refname)' --contains "$head" refs/heads refs/tags 2>/dev/null | grep -q . || return 0
  size=$(du -sb -- "$d" 2>/dev/null | awk '{print $1}' || echo 0)
  find "$d" -xdev -depth -delete
  case "$bucket" in
    remote) remote_dir_count=$((remote_dir_count+1)) ;;
    operator) operator_dir_count=$((operator_dir_count+1)) ;;
    *) dir_count=$((dir_count+1)) ;;
  esac
  bytes=$((bytes+size))
}

if [[ "$workspace_cleanup_allowed" == true && -d "$TEMP_ROOT" ]]; then
  while IFS= read -r -d '' d; do
    reclaim_git_dir "$d" "$CANONICAL_AWH_GIT" normal
  done < <(find "$TEMP_ROOT" -xdev -maxdepth 1 -mindepth 1 -type d -name 'awh-*' -mmin "+${DIR_MAX_AGE_MINUTES}" -print0)
fi

# Desktop Commander uses PrivateTmp. Root maintenance can see the physical
# systemd-private tree. Reclaim only old, clean, canonical-backed Git clones
# while every canonical mutation lane is idle.
# Operator staging is an ephemeral handoff/workspace area. Reclaim only old
# clean clones whose exact HEAD is already present in the canonical origin.
# Unknown remotes, dirty trees, open files, and non-Git artifacts are preserved.
if [[ "$global_cleanup_allowed" == true && -d "$OPERATOR_STAGE_ROOT" ]]; then
  while IFS= read -r -d '' d; do
    [[ -d "$d/.git" && ! -L "$d/.git" ]] || continue
    origin=$(git_workspace "$d" remote get-url origin 2>/dev/null || true)
    case "$origin" in
      /srv/awh-git/*.git|file:///srv/awh-git/*.git) canonical="${origin#file://}" ;;
      "$CANONICAL_ROOT"/*.git) canonical="$origin" ;;
      file://"$CANONICAL_ROOT"/*.git) canonical="${origin#file://}" ;;
      *) continue ;;
    esac
    [[ -d "$canonical" ]] || continue
    reclaim_git_dir "$d" "$canonical" operator
  done < <(find "$OPERATOR_STAGE_ROOT" -xdev -maxdepth 1 -mindepth 1 -type d -mmin "+${OPERATOR_STAGE_MAX_AGE_MINUTES}" -print0)
fi

reclaim_dependency_dirs() {
  local root=$1 d parent size
  [[ -d "$root" ]] || return 0
  while IFS= read -r -d '' d; do
    parent=$(dirname "$d")
    [[ -f "$parent/package.json" ]] || continue
    [[ -f "$parent/package-lock.json" || -f "$parent/bun.lock" || -f "$parent/pnpm-lock.yaml" || -f "$parent/yarn.lock" ]] || continue
    path_in_use "$parent" && continue
    size=$(du -sb -- "$d" 2>/dev/null | awk '{print $1}' || echo 0)
    rm -rf -- "$d"
    bytes=$((bytes+size))
  done < <(find "$root" -xdev -mindepth 2 -maxdepth 2 -type d -name node_modules -mmin "+${DEPENDENCY_MAX_AGE_MINUTES}" -print0)
}

purge_regenerable_cache() {
  local d size
  for d in "$REMOTE_ELECTRON_CACHE" "$REMOTE_NPM_CACHE" "$CORE_NPM_CACHE" "$REMOTE_UV_CACHE"; do
    [[ -d "$d" ]] || continue
    path_in_use "$d" && continue
    size=$(du -sb -- "$d" 2>/dev/null | awk '{print $1}' || echo 0)
    rm -rf -- "$d"
    bytes=$((bytes+size))
  done
}

purge_core_npm_cache_if_oversize() {
  [[ -d "$CORE_NPM_CACHE" ]] || return 0
  path_in_use "$CORE_NPM_CACHE" && return 0
  local size
  size=$(du -sb -- "$CORE_NPM_CACHE" 2>/dev/null | awk '{print $1}' || echo 0)
  [[ "$size" =~ ^[0-9]+$ ]] || return 0
  (( size >= CORE_NPM_CACHE_MAX_BYTES )) || return 0
  rm -rf -- "$CORE_NPM_CACHE"
  bytes=$((bytes+size))
}

if [[ "$global_cleanup_allowed" == true ]]; then
  reclaim_dependency_dirs "$TEMP_ROOT"
  reclaim_dependency_dirs "$OPERATOR_STAGE_ROOT"
  purge_core_npm_cache_if_oversize
  if [[ "${AWH_STORAGE_PRESSURE:-0}" == 1 ]]; then
    purge_old_vault_exports
    purge_regenerable_cache
  fi
fi

if [[ "$global_cleanup_allowed" == true ]]; then
  for private_tmp in /tmp/systemd-private-*-desktop-commander-vps.service-*/tmp; do
    [[ -d "$private_tmp" ]] || continue
    while IFS= read -r -d '' d; do
      case "$(basename "$d")" in
        awh-*) reclaim_git_dir "$d" "$CANONICAL_AWH_GIT" remote ;;
        bay-*) reclaim_git_dir "$d" "$CANONICAL_BAY_GIT" remote ;;
      esac
    done < <(find "$private_tmp" -xdev -maxdepth 1 -mindepth 1 -type d \( -name 'awh-*' -o -name 'bay-*' \) -mmin "+${REMOTE_PRIVATE_MAX_AGE_MINUTES}" -print0)
  done
fi

logger -t awh-temp-cleanup "purged_files=$count purged_dirs=$dir_count remote_purged_dirs=$remote_dir_count remote_transient_dirs=$remote_transient_dir_count operator_purged_dirs=$operator_dir_count reclaimed_bytes=$bytes workspace_janitor=$janitor_state janitor_reclaimed_bytes=$janitor_reclaimed workspace_cleanup_allowed=$workspace_cleanup_allowed active_mutations=$active_mutations global_cleanup_allowed=$global_cleanup_allowed global_active_mutations=$global_active_mutations"
