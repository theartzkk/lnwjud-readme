#!/usr/bin/env bash
set -euo pipefail
CANONICAL_AWH_GIT=${AWH_CANONICAL_AWH_GIT:-/srv/awh-git/awh.git}
CANONICAL_BAY_GIT=${AWH_CANONICAL_BAY_GIT:-/srv/awh-git/bay-excuse-x.git}
HUB_DB=${AWH_HUB_DB_PATH:-/var/lib/awh-hub/awh.sqlite}
TEMP_ROOT=${AWH_TEMP_ROOT:-/tmp}
REMOTE_TEMP_ROOT=${AWH_REMOTE_TEMP_ROOT:-/var/lib/awh-remote/tmp}
OPERATOR_STAGE_ROOT=${AWH_OPERATOR_STAGE_ROOT:-/var/lib/awh-remote/operator-staging}
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
WORKSPACE_JANITOR=${AWH_TEMP_WORKSPACE_JANITOR:-$SCRIPT_DIR/awh-temp-workspace-janitor.py}
DIR_MAX_AGE_MINUTES=${AWH_TEMP_DIR_MAX_AGE_MINUTES:-720}
REMOTE_PRIVATE_MAX_AGE_MINUTES=${AWH_REMOTE_PRIVATE_MAX_AGE_MINUTES:-180}
OPERATOR_STAGE_MAX_AGE_MINUTES=${AWH_OPERATOR_STAGE_MAX_AGE_MINUTES:-1440}
count=0
dir_count=0
remote_dir_count=0
operator_dir_count=0
bytes=0

purge_old_files() {
  local root=$1
  [[ -d "$root" ]] || return 0
  while IFS= read -r -d '' f; do
    if command -v lsof >/dev/null 2>&1 && lsof "$f" >/dev/null 2>&1; then
      continue
    fi
    local size
    size=$(stat -c %s "$f" 2>/dev/null || echo 0)
    rm -f -- "$f"
    count=$((count+1))
    bytes=$((bytes+size))
  done < <(find "$root" -xdev -maxdepth 1 -type f \( -name 'awh-*' -o -name 'actions-runner-*.tar.gz' \) -mtime +7 -print0)
}
purge_old_files "$TEMP_ROOT"
purge_old_files "$REMOTE_TEMP_ROOT"

janitor_state=NOT_AVAILABLE
janitor_reclaimed=0
if [[ -f "$WORKSPACE_JANITOR" ]]; then
  janitor_args=(--apply)
  if [[ "${AWH_STORAGE_PRESSURE:-0}" == 1 ]]; then janitor_args+=(--pressure); fi
  set +e
  janitor_json=$(/usr/bin/python3 "$WORKSPACE_JANITOR" "${janitor_args[@]}" 2>&1)
  janitor_rc=$?
  set -e
  if (( janitor_rc == 0 )); then
    janitor_state=OK
    janitor_reclaimed=$(printf '%s' "$janitor_json" | /usr/bin/python3 -c 'import json,sys; print(int(json.load(sys.stdin).get("reclaimedLogicalBytes",0)))' 2>/dev/null || echo 0)
    [[ "$janitor_reclaimed" =~ ^[0-9]+$ ]] || janitor_reclaimed=0
    bytes=$((bytes+janitor_reclaimed))
  else
    janitor_state=FAILED
    logger -t awh-temp-cleanup "workspace_janitor_failed rc=$janitor_rc"
  fi
fi

workspace_cleanup_allowed=false
global_cleanup_allowed=false
active_mutations=unknown
global_active_mutations=unknown
if [[ -r "$HUB_DB" ]] && command -v sqlite3 >/dev/null 2>&1; then
  mutation_sql="e.state IN ('LEASED','RUNNING') AND (x.execution_id IS NULL OR (x.mutation_scope<>'READ' AND x.state='ACTIVE' AND (x.lease_expires_at IS NULL OR datetime(x.lease_expires_at)>datetime('now'))))"
  if active_mutations=$(sqlite3 -readonly "$HUB_DB" "SELECT count(*) FROM control_task_executions e JOIN projects p ON p.project_id=e.project_id LEFT JOIN control_execution_envelopes x ON x.execution_id=e.execution_id WHERE p.name='Art’s Workspace Hub' AND $mutation_sql;" 2>/dev/null); then
    [[ "$active_mutations" =~ ^[0-9]+$ ]] && (( active_mutations == 0 )) && workspace_cleanup_allowed=true
  fi
  if global_active_mutations=$(sqlite3 -readonly "$HUB_DB" "SELECT count(*) FROM control_task_executions e LEFT JOIN control_execution_envelopes x ON x.execution_id=e.execution_id WHERE $mutation_sql;" 2>/dev/null); then
    [[ "$global_active_mutations" =~ ^[0-9]+$ ]] && (( global_active_mutations == 0 )) && global_cleanup_allowed=true
  fi
fi

reclaim_git_dir() {
  local d=$1 canonical=$2 bucket=$3
  [[ -d "$d/.git" && ! -L "$d/.git" ]] || return 0
  if command -v lsof >/dev/null 2>&1 && lsof +D "$d" >/dev/null 2>&1; then
    return 0
  fi
  local status head size
  status=$(git -C "$d" status --porcelain=v1 2>/dev/null || printf '__UNREADABLE__')
  [[ -z "$status" ]] || return 0
  head=$(git -C "$d" rev-parse HEAD 2>/dev/null || true)
  [[ "$head" =~ ^[0-9a-f]{40}$ ]] || return 0
  git --git-dir="$canonical" cat-file -e "${head}^{commit}" 2>/dev/null || return 0
  size=$(du -sb -- "$d" 2>/dev/null | awk '{print $1}' || echo 0)
  find "$d" -xdev -depth -delete
  case "$bucket" in
    remote) remote_dir_count=$((remote_dir_count+1)) ;;
    operator) operator_dir_count=$((operator_dir_count+1)) ;;
    *) dir_count=$((dir_count+1)) ;;
  esac
  bytes=$((bytes+size))
}

if [[ "$workspace_cleanup_allowed" == true && -d "$TEMP_ROOT" ]]; then
  while IFS= read -r -d '' d; do
    reclaim_git_dir "$d" "$CANONICAL_AWH_GIT" normal
  done < <(find "$TEMP_ROOT" -xdev -maxdepth 1 -mindepth 1 -type d -name 'awh-*' -mmin "+${DIR_MAX_AGE_MINUTES}" -print0)
fi

# Desktop Commander uses PrivateTmp. Root maintenance can see the physical
# systemd-private tree. Reclaim only old, clean, canonical-backed Git clones
# while every canonical mutation lane is idle.
# Operator staging is an ephemeral handoff/workspace area. Reclaim only old
# clean clones whose exact HEAD is already present in the canonical origin.
# Unknown remotes, dirty trees, open files, and non-Git artifacts are preserved.
if [[ "$global_cleanup_allowed" == true && -d "$OPERATOR_STAGE_ROOT" ]]; then
  while IFS= read -r -d '' d; do
    [[ -d "$d/.git" && ! -L "$d/.git" ]] || continue
    origin=$(git -C "$d" remote get-url origin 2>/dev/null || true)
    case "$origin" in
      file:///srv/awh-git/*.git)
        canonical="/srv/awh-git/${origin#file:///srv/awh-git/}"
        [[ -d "$canonical" ]] || continue
        reclaim_git_dir "$d" "$canonical" operator
        ;;
    esac
  done < <(find "$OPERATOR_STAGE_ROOT" -xdev -maxdepth 1 -mindepth 1 -type d -mmin "+${OPERATOR_STAGE_MAX_AGE_MINUTES}" -print0)
fi

if [[ "$global_cleanup_allowed" == true ]]; then
  for private_tmp in /tmp/systemd-private-*-desktop-commander-vps.service-*/tmp; do
    [[ -d "$private_tmp" ]] || continue
    while IFS= read -r -d '' d; do
      case "$(basename "$d")" in
        awh-*) reclaim_git_dir "$d" "$CANONICAL_AWH_GIT" remote ;;
        bay-*) reclaim_git_dir "$d" "$CANONICAL_BAY_GIT" remote ;;
      esac
    done < <(find "$private_tmp" -xdev -maxdepth 1 -mindepth 1 -type d \( -name 'awh-*' -o -name 'bay-*' \) -mmin "+${REMOTE_PRIVATE_MAX_AGE_MINUTES}" -print0)
  done
fi

logger -t awh-temp-cleanup "purged_files=$count purged_dirs=$dir_count remote_purged_dirs=$remote_dir_count operator_purged_dirs=$operator_dir_count reclaimed_bytes=$bytes workspace_janitor=$janitor_state janitor_reclaimed_bytes=$janitor_reclaimed workspace_cleanup_allowed=$workspace_cleanup_allowed active_mutations=$active_mutations global_cleanup_allowed=$global_cleanup_allowed global_active_mutations=$global_active_mutations"
